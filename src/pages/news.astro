---
import NewsCard from "../components/NewsCard.astro";
import { Icon } from "astro-icon/components";
import "../styles/global.css";
import "katex/dist/katex-swap.css";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
  <head>
    <title>News & Media Coverage</title>
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Media coverage and press mentions of our WACV 2026 paper." />
  <meta content="somsubhra" name="author">
    <meta content="AI4Fashion,AI,FLORA,NeRA,adapters,PEFT,LoRA,Gen AI,Kolmogorov Arnold Networks,fashion dataset,WACV,WACV 2026,Applications,Candle Lab IITR" name="keywords">
 <script src="/WACV2026-FLORA-Dataset-NeRA-Adapter/js/global.js" type="module"></script> 
  </head>

  <body class="bg-white dark:bg-zinc-900 text-slate-800 dark:text-slate-100">

<header id="pageHeader" class="w-full sticky top-0 z-50 flex items-center justify-between py-2 px-4 transition-colors duration-300">
  <div class="relative flex-shrink-0">
    <button 
      id="menuButton" 
      class="px-3 py-1 rounded-lg text-slate-800 hover:bg-slate-100 transition-all duration-200 flex items-center gap-1"
      aria-expanded="false"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
      Menu
    </button>

    <div id="menuDropdown" class="absolute left-0 mt-2 w-40 bg-white rounded-lg shadow-lg opacity-0 invisible transition-all duration-200">
      <a href="/WACV2026-FLORA-Dataset-NeRA-Adapter" class="flex items-center gap-2 px-4 py-2 text-slate-800 hover:bg-blue-100 rounded-t-lg"><Icon name="ri:home-fill" /> Home</a>
      <a href="mailto:sparsh.mittal@ece.iitr.ac.in" target="_blank" class="flex items-center gap-2 px-4 py-2 text-slate-800 hover:bg-blue-100 rounded-t-lg"><Icon name="ri:mail-fill" /> Contact</a>
      <a href="/WACV2026-FLORA-Dataset-NeRA-Adapter/news" target="_blank" class="flex items-center gap-2 px-4 py-2 text-slate-800 hover:bg-blue-100 rounded-t-lg"><Icon name="ri:newspaper-fill" /> News</a>
    </div>
  </div>

<h1 class="text-center text-base font-medium text-black flex-1 mx-4 truncate">
Welcome to our Project Page!
  </h1>

  <div class="flex-shrink-0">
    <button 
      id="shareButton" 
      class="px-3 py-1 rounded-lg text-slate-800 hover:bg-slate-100 transition-all duration-200 flex items-center gap-1"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v14" />
      </svg>
      Share
    </button>
  </div>
</header>

    <section class="mx-auto max-w-[60rem] px-6 pt-12">
      <h1 class="text-3xl font-bold text-center text-[#3b3f8f]">
        In The News
      </h1>
      <p class="mt-3 text-center text-slate-600 dark:text-slate-400">
        By God's grace, our work has been featured in selected press mentions, articles and media coverage.
      </p>
    </section>

    <section class="mx-auto max-w-[70rem] px-6 py-10">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <NewsCard
          title="IITR unveils India's first text to fashion sketch AI system ..."
          outlet="The Times of India"
          date="31 Jan 2026"
          link="https://timesofindia.indiatimes.com/city/dehradun/iit-r-unveils-indias-first-text-to-fashion-sketch-ai-system/articleshow/127807438.cms"
          image="https://static.toiimg.com/thumb/127807438.jpg?imgsize=43122&photoid=127807438&width=600&resizemode=4"
        />

        <NewsCard
          title="IIT Roorkee Breakthrough Blends Artificial Intelligence and Design to Power Sustainable Fashion of the Future"
          outlet="Press Information Bureau, GoI"
          date="30 Jan 2026"
          link="https://www.pib.gov.in/PressReleseDetailm.aspx?PRID=2221048&reg=3&lang=2"
          image="https://static.pib.gov.in/WriteReadData/userfiles/image/WhatsAppImage2026-01-30at18.01.51LBAK.jpeg"
        />

        <NewsCard
          title="IIT Roorkee Breakthrough Blends Artificial Intelligence and Design to Power Sustainable Fashion of the Future"
          outlet="City Air News"
          date="30 Jan 2026"
          link="https://www.cityairnews.com/content/iit-roorkee-breakthrough-blends-artificial-intelligence-and-design-to-power-sustainable-fashion-of-the-future"
          image="https://www.cityairnews.com/uploads/images/image_750x_5e15b93be6415.jpg"
        />

        <NewsCard
          title="IIT Roorkee makes major innovation in AI fashion: FLORA and NeRA will make sketches smarter, changing the future of design"
          outlet="Dainik Bhaskar"
          date="31 Jan 2026"
          link="https://www.bhaskar.com/local/uttarakhand/haridwar/roorkee/news/iit-roorkee-ai-fashion-flora-nera-design-innovation-137081780.html"
          image="https://images.bhaskarassets.com/webp/thumb/512x0/web2images/521/2026/01/30/58f2dfd9-09d8-421f-8dce-36dd52217ed9_1769783999245.jpg"
        />

      </div>
    </section>

    <section class="pb-16 text-center text-sm text-slate-500 dark:text-slate-400">
      <Icon name="ri:newspaper-line" class="inline-block mr-1" />
      More info coming soon.
    </section>

<footer class="w-full bg-[#cdc5ed] mt-12">
  <div class="flex w-full flex-col items-center justify-between gap-3 px-4 py-4 text-sm text-slate-700 md:flex-row">
  <p class="text-center md:text-left">
      <a
        href="https://github.com/CandleLabAI/WACV2026-FLORA-Dataset-NeRA-Adapter/tree/gh-pages" 
        target="_blank"
        class="!text-violet-800 !underline hover:!text-violet-900"
      >
        Website Code</a>, adapted from 
      <a
        href="https://github.com/RomanHauksson/academic-project-astro-template" 
        target="_blank"
        class="!text-violet-800 !underline hover:!text-violet-900"
      >
        Roman Hauksson's Academic Astro template</a>
      licensed under
      <a 
        href="http://creativecommons.org/licenses/by-sa/4.0/" 
        target="_blank"
        class="!text-violet-800 !underline hover:!text-violet-900"
      >
        CC BY-SA 4.0</a>.<br>
        Open-sourced with <Icon name="ri:heart-fill" class="text-red-600 inline-block" /> for the community.
    </p>
    <div class="text-center text-xs text-slate-600 md:text-right">
      Page Visits: <a href="https://www.freecounterstat.com" target="_blank" title="free website counter"><img src="https://counter1.optistats.ovh/private/freecounterstat.php?c=ad8r987d64gblgbae5gxbwmjaryjwzs1" border="0" title="free website counter" alt="free website counter"></a>
    </div>

  </div>
</footer>
  <button id="goTop" class="go-to-top"><Icon name="ri:arrow-up-line" class="w-5 h-5" /></button>
  </body>
</html>